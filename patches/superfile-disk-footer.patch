+func filesystemFooterInfo(path string) string {
+	var fs syscall.Statfs_t
+	if err := syscall.Statfs(path, &fs); err != nil {
+		return ""
+	}
+
+	blockSize := uint64(fs.Bsize)
+	total := fs.Blocks * blockSize
+	free := fs.Bavail * blockSize
+	if total == 0 {
+		return ""
+	}
+
+	used := total - free
+	percent := used * 100 / total
+
+	return fmt.Sprintf(
+		"Disk %s/%s · %s free · %d%%",
+		formatFilesystemBytes(used),
+		formatFilesystemBytes(total),
+		formatFilesystemBytes(free),
+		percent,
+	)
+}
+
+func formatFilesystemBytes(bytes uint64) string {
+	const gib = uint64(1024 * 1024 * 1024)
+	return fmt.Sprintf("%.1f GiB", float64(bytes)/float64(gib))
