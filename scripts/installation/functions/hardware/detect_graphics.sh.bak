detect_graphics() {
    local pci gpu count
    local first_bus first_vendor
    local integrated_gpu integrated_bus
    local passthrough_ids
    local line bus_id vendor_id device_id
    local -a gpu_lines=()

    cfg_graphics_vendor="unknown"
    cfg_graphics_type="integrated"
    cfg_graphics_compute=false
    cfg_graphics_bus_id=""
    cfg_graphics_integrated_bus_id=""
    cfg_graphics_passthrough_ids=""

    if ! command -v lspci >/dev/null 2>&1; then
        say '[NOTE] lspci unavailable; using generic graphics support.'
        return 0
    fi

    pci="$(lspci -Dnn 2>/dev/null || true)"

    gpu="$(
        printf '%s\n' "$pci" |
            grep -Ei 'VGA compatible controller|3D controller|Display controller' ||
            true
    )"

    count="$(printf '%s\n' "$gpu" | sed '/^[[:space:]]*$/d' | wc -l)"

    if (( count == 0 )); then
        say 'Detected graphics: unknown (integrated)'
        return 0
    fi

    while IFS= read -r line; do
        [[ -n "$line" ]] && gpu_lines+=("$line")
    done <<< "$gpu"

    first_bus="$(printf '%s\n' "${gpu_lines[0]}" | awk '{print $1}')"
    first_vendor="$(printf '%s\n' "${gpu_lines[0]}" | awk -F': ' '{print $2}' | cut -d' ' -f1)"

    # Convert a Linux PCI address such as:
    #
    #   0000:c1:00.0
    #
    # into the Xorg-style BusID:
    #
    #   PCI:193:0:0
    #
    pci_to_xorg() {
        local bdf="$1"
        local domain bus device function

        IFS=':.' read -r domain bus device function <<< "$bdf"

        # Xorg BusID uses the PCI bus/device/function and ignores domain.
        printf 'PCI:%d:%d:%d' \
            "$((16#$bus))" \
            "$((16#$device))" \
            "$((16#$function))"
    }

    # Find an integrated controller.
    #
    # Intel graphics are integrated by definition for this installer.
    # AMD APUs/iGPUs are identified using common Phoenix/Radeon naming.
    # NVIDIA GPUs are treated as dedicated, including mobile/laptop GPUs.
    integrated_gpu=""

    for line in "${gpu_lines[@]}"; do
        if printf '%s\n' "$line" | grep -qiE 'Intel Corporation.*(UHD|Iris|Xe|Graphics)|Intel.*Graphics'; then
            integrated_gpu="$line"
            break
        fi

        if printf '%s\n' "$line" | grep -qiE 'AMD/ATI.*(Radeon 7[0-9]{2}M|Radeon 6[0-9]{2}M|Radeon Graphics|Phoenix|Rembrandt|Barcelo|Cezanne|Lucienne|Renoir|Mendocino|Van Gogh|Raphael|Strix|Hawk Point|Hera|780M|760M|740M)'; then
            integrated_gpu="$line"
            break
        fi
    done

    # If there is only one controller and it looks like Intel graphics,
    # it is integrated.
    if (( count == 1 )); then
        if printf '%s\n' "${gpu_lines[0]}" | grep -qi 'Intel'; then
            integrated_gpu="${gpu_lines[0]}"
        elif printf '%s\n' "${gpu_lines[0]}" | grep -qiE 'AMD/ATI.*(Radeon Graphics|Phoenix|780M|760M|740M)'; then
            integrated_gpu="${gpu_lines[0]}"
        fi
    fi

    # Determine the primary graphics vendor.
    if printf '%s\n' "$gpu" | grep -qi 'NVIDIA'; then
        cfg_graphics_vendor="nvidia"
        cfg_graphics_compute=true
    elif printf '%s\n' "$gpu" | grep -qi 'AMD/ATI\|Advanced Micro Devices'; then
        cfg_graphics_vendor="amd"
        cfg_graphics_compute=true
    elif printf '%s\n' "$gpu" | grep -qi 'Intel'; then
        cfg_graphics_vendor="intel"
        cfg_graphics_compute=false
    fi

    # Determine graphics topology.
    if (( count > 1 )); then
        if [[ -n "$integrated_gpu" ]]; then
            cfg_graphics_type="hybrid"
        else
            cfg_graphics_type="hybrid"
        fi
    elif [[ -n "$integrated_gpu" ]]; then
        cfg_graphics_type="integrated"
    else
        cfg_graphics_type="dedicated"
    fi

    # Primary/first GPU BusID.
    if [[ -n "$first_bus" ]]; then
        cfg_graphics_bus_id="$(pci_to_xorg "$first_bus")"
    fi

    # Integrated GPU BusID.
    if [[ -n "$integrated_gpu" ]]; then
        integrated_bus="$(printf '%s\n' "$integrated_gpu" | awk '{print $1}')"

        if [[ -n "$integrated_bus" ]]; then
            cfg_graphics_integrated_bus_id="$(pci_to_xorg "$integrated_bus")"
            say "Detected integrated GPU bus: ${cfg_graphics_integrated_bus_id}"
        fi
    fi

    # Collect vendor:device IDs for actual GPU controllers.
    #
    # Example:
    #   1002:15bf
    #   10de:2684
    #
    passthrough_ids=""

    for line in "${gpu_lines[@]}"; do
        vendor_id=""
        device_id=""

        while read -r bus_id vendor_id device_id; do
            [[ "$vendor_id" =~ ^[0-9a-fA-F]{4}$ ]] || continue
            [[ "$device_id" =~ ^[0-9a-fA-F]{4}$ ]] || continue

            # Do not automatically mark Intel graphics for passthrough.
            if [[ "$line" == *Intel* ]]; then
                continue
            fi

            if [[ -n "$passthrough_ids" ]]; then
                passthrough_ids+=" "
            fi

            passthrough_ids+="${vendor_id}:${device_id}"
        done < <(
            printf '%s\n' "$line" |
                sed -nE 's/^[[:space:]]*([^ ]+).*?\[([0-9a-fA-F]{4}):([0-9a-fA-F]{4})\].*$/\1 \2 \3/p'
        )
    done

    cfg_graphics_passthrough_ids="$(
        printf '%s\n' "$passthrough_ids" |
            tr ' ' '\n' |
            sed '/^[[:space:]]*$/d' |
            sort -u |
            paste -sd' ' -
    )"

    say "Detected graphics: ${cfg_graphics_vendor} (${cfg_graphics_type})"

    if [[ -n "$cfg_graphics_integrated_bus_id" ]]; then
        say "Detected integrated GPU: ${cfg_graphics_integrated_bus_id}"
    fi

    if [[ -n "$cfg_graphics_passthrough_ids" ]]; then
        say "Detected GPU PCI IDs: ${cfg_graphics_passthrough_ids}"
    fi
}
