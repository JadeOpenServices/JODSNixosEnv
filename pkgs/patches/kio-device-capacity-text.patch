+
+        // Keep capacity information visible in narrow Places panels. The
+        // device name yields horizontal space first, while the bar retains
+        // the full text-area width underneath both labels.
+        if (isLTR) {
+            labelRect.setRight(qMax(labelRect.left(), labelRect.right() - capacityTextWidth - capacityTextSpacing));
+        } else {
+            labelRect.setLeft(qMin(labelRect.right(), labelRect.left() + capacityTextWidth + capacityTextSpacing));
+        }
+    }
