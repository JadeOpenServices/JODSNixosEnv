+        if (errno != 0) {
+          ok = false;
+          error = "cannot read staging directory";
+        }
+        break;
+      }
+      if (std::strcmp(entry->d_name, ".") == 0 || std::strcmp(entry->d_name, "..") == 0) {
+        continue;
+      }
+      if (++count > kMaxStagedFiles) {
+        ok = false;
+        error = "staging directory has too many entries";
+        break;
+      }
+      ok = copyStagedFile(dir, out, entry->d_name, error);
+    }
+    if (listing != nullptr) {
+      ::closedir(listing);
+    }
+    if (out >= 0) {
+      ::close(out);
+    }
+    ::close(dir);
+    if (!ok) {
+      std::error_code ec;
+      std::filesystem::remove_all(snapshot, ec);
+      return std::nullopt;
+    }
+    return std::filesystem::path(snapshot);
+  }
