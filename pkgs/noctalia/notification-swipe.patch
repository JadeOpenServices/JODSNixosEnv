+// Swipe a card sideways to dismiss it: drag with a mouse or finger, or scroll
+// horizontally on a touchpad. Short swipes spring back.
+void NotificationToast::installSwipeToDismiss(
+    Instance& inst, InputArea* area, const std::shared_ptr<SwipeState>& swipe, uint32_t notificationId, float cardW,
+    float scale
+) {
+  SwipeState* const state = swipe.get();
+  const float restX = horizontalInnerPad(scale);
+  const float slop = 8.0F * scale;
+  const float threshold = cardW * 0.3F;
+
+  const auto moveTo = [area, state, restX, cardW](float dx) {
+    state->dx = dx;
+    area->setPosition(restX + dx, area->y());
+    area->setOpacity(std::clamp(1.0F - std::abs(dx) / cardW, 0.0F, 1.0F));
+  };
+
+  const auto settle = [this, &inst, area, state, moveTo, threshold, cardW, notificationId]() {
+    if (state->animId != 0) {
+      inst.animations.cancel(state->animId);
+      state->animId = 0;
+    }
+    const float from = state->dx;
+    if (std::abs(from) >= threshold) {
+      const float to = std::copysign(cardW, from);
+      state->animId = inst.animations.animate(
+          from, to, Style::animFast, Easing::EaseOutCubic, moveTo,
+          [this, area, state, notificationId]() {
+            state->animId = 0;
+            area->setOpacity(0.0F);
+            DeferredCall::callLater([this, notificationId]() { requestClose(notificationId, CloseReason::Dismissed); });
+          },
+          area
+      );
+    } else if (from != 0.0F) {
+      state->animId = inst.animations.animate(
+          from, 0.0F, Style::animNormal, Easing::EaseOutCubic, moveTo, [state]() { state->animId = 0; }, area
+      );
+    }
+    inst.surface->requestRedraw();
+  };
+
+  area->setOnPress([&inst, area, state, settle](const InputArea::PointerData& data) {
+    if (data.button != BTN_LEFT) {
+      return;
+    }
+    if (data.pressed) {
+      if (state->animId != 0) {
+        inst.animations.cancel(state->animId);
+        state->animId = 0;
+      }
+      state->tracking = true;
+      state->moved = false;
+      state->startX = data.localX + area->x() - state->dx;
+      return;
+    }
+    if (state->tracking) {
+      state->tracking = false;
+      settle();
+    }
+  });
+
+  area->setOnMotion([area, state, moveTo, slop](const InputArea::PointerData& data) {
+    if (!state->tracking || !area->pressed()) {
+      return;
+    }
+    // Local coordinates move with the card, so add the card position back.
+    const float dx = data.localX + area->x() - state->startX;
+    if (!state->moved && std::abs(dx) < slop) {
+      return;
+    }
+    state->moved = true;
+    moveTo(dx);
+  });
+
+  area->setOnCancel([state, settle]() {
+    if (state->tracking) {
+      state->tracking = false;
+      settle();
+    }
+  });
+
+  area->setOnAxisHandler([&inst, state, moveTo, settle](const InputArea::PointerData& data) {
+    if (data.axis != WL_POINTER_AXIS_HORIZONTAL_SCROLL || data.axisSource != WL_POINTER_AXIS_SOURCE_FINGER
+        || state->tracking) {
+      return false;
+    }
+    if (state->animId != 0) {
+      inst.animations.cancel(state->animId);
+      state->animId = 0;
+    }
+    state->moved = true;
+    moveTo(state->dx - static_cast<float>(data.axisValue));
+    // Touchpads send no reliable end event here; settle once the fingers stop.
+    state->axisIdle.start(std::chrono::milliseconds(120), [state, settle]() {
+      state->moved = false;
+      settle();
+    });
+    return true;
+  });
+}
