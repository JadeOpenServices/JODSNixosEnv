diff --git a/src/config/config_types.h b/src/config/config_types.h
--- a/src/config/config_types.h
+++ b/src/config/config_types.h
@@ -1301,6 +1301,9 @@ struct BatteryDeviceWarningThreshold {
 struct BatteryConfig {
   // 0 disables the low-battery warning notification and widget warning state by default.
   std::int32_t warningThreshold = 10;
+  // false leaves low-battery notifications for the system battery to another service; the bar
+  // widget keeps its warning state.
+  bool notifySystemBattery = true;
   std::vector<BatteryDeviceWarningThreshold> deviceThresholds;
 
   bool operator==(const BatteryConfig&) const = default;
diff --git a/src/config/schema/config_schema.cpp b/src/config/schema/config_schema.cpp
--- a/src/config/schema/config_schema.cpp
+++ b/src/config/schema/config_schema.cpp
@@ -454,6 +454,7 @@ namespace noctalia::config::schema {
   const Schema<BatteryConfig>& batterySchema() {
     static const Schema<BatteryConfig> s = {
         field(&BatteryConfig::warningThreshold, "warning_threshold", kBatteryWarningThresholdRange),
+        field(&BatteryConfig::notifySystemBattery, "notify_system_battery"),
         // selector comes only from the map key; empty selectors are dropped.
         namedMap<BatteryConfig, BatteryDeviceWarningThreshold>(
             &BatteryConfig::deviceThresholds, "device", batteryDeviceSchema(),
diff --git a/src/system/battery_warning_monitor.cpp b/src/system/battery_warning_monitor.cpp
--- a/src/system/battery_warning_monitor.cpp
+++ b/src/system/battery_warning_monitor.cpp
@@ -176,7 +176,8 @@ void BatteryWarningMonitor::evaluate(
 
     // Re-arm when charging, absent, or warnings disabled. firedLevel is percentage-based, so a
     // threshold change across config reloads needs no special handling — the next level decides.
-    if (!device.state.isPresent || isPluggedIn(device.state.state) || threshold <= 0) {
+    if (!device.state.isPresent || isPluggedIn(device.state.state) || threshold <= 0 ||
+        (isSystem && !config.notifySystemBattery)) {
       state.firedLevel = kNoLevel;
       continue;
     }
