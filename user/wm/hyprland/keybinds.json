{
  "bindm": [
    {"mods":"$mod","key":"mouse:272","action":"movewindow","desc":"Move window"},
    {"mods":"$mod","key":"mouse:273","action":"resizewindow","desc":"Resize window"},
    {"mods":"$mod SHIFT","key":"mouse:272","action":"resizewindow","desc":"Resize window"}
  ],
  "binde": [
    {"key":"XF86AudioRaiseVolume","action":"exec","command":"volumeUp","desc":"Volume up"},
    {"key":"XF86AudioLowerVolume","action":"exec","command":"volumeDown","desc":"Volume down"},
    {"key":"XF86MonBrightnessUp","action":"exec","command":"brightnessUp","desc":"Brightness up"},
    {"key":"XF86MonBrightnessDown","action":"exec","command":"brightnessDown","desc":"Brightness down"},
    {"mods":"$mod ALT","key":"k","action":"exec","command":"volumeUp","desc":"Volume up"},
    {"mods":"$mod ALT","key":"j","action":"exec","command":"volumeDown","desc":"Volume down"},
    {"mods":"$mod CTRL","key":"Left","action":"resizeactive","args":"-40 0","desc":"Make window narrower"},
    {"mods":"$mod CTRL","key":"Right","action":"resizeactive","args":"40 0","desc":"Make window wider"},
    {"mods":"$mod CTRL","key":"Up","action":"resizeactive","args":"0 -40","desc":"Make window shorter"},
    {"mods":"$mod CTRL","key":"Down","action":"resizeactive","args":"0 40","desc":"Make window taller"}
  ],
  "bind": [
    {"mods":"$mod","key":"Q","action":"killactive","desc":"Close window"},
    {"mods":"$mod","key":"W","action":"fullscreen","args":"1","desc":"Maximize window"},

    {"mods":"$mod","key":"E","action":"exec","command":"editor","desc":"Open editor"},
    {"mods":"$mod","key":"B","action":"exec","command":"browser","desc":"Open browser"},
    {"mods":"$mod","key":"T","action":"exec","command":"terminal","desc":"Open terminal"},
    {"mods":"$mod","key":"F","action":"exec","command":"fileManager","desc":"Open file manager"},
    {"mods":"$mod","key":"A","action":"exec","command":"gjallarAI","desc":"Open Gjallar AI"},
    {"mods":"$mod","key":"N","action":"exec","command":"libreoffice","desc":"Open LibreOffice"},
    {"mods":"$mod","key":"M","action":"exec","command":"teams","desc":"Open Teams"},

    {"mods":"$mod","key":"Delete","action":"exit","desc":"Log out"},
    {"mods":"$mod","key":"O","action":"layoutmsg","args":"togglesplit","desc":"Switch split direction"},
    {"mods":"$mod","key":"P","action":"pseudo","desc":"Keep window size inside its tile"},
    {"mods":"$mod","key":"Escape","action":"exec","command":"lock","desc":"Lock screen"},
    {"mods":"$mod","key":"F1","action":"exec","command":"keybinds","desc":"Show keyboard shortcuts"},

    {"mods":"$mod SHIFT","key":"Return","action":"exec","command":"terminal","args":"--class floating","desc":"Open floating terminal"},

    {"mods":"$mod","key":"S","action":"togglespecialworkspace","desc":"Show or hide scratchpad"},
    {"mods":"$mod SHIFT","key":"S","action":"movetoworkspacesilent","args":"special","desc":"Move window to scratchpad"},
    {"mods":"$mod SHIFT","key":"A","action":"exec","command":"launcher","desc":"Open launcher"},
    {"mods":"$mod","key":"D","action":"exec","command":"launcher","desc":"Open launcher"},
    {"mods":"$mod SHIFT","key":"Z","action":"exec","command":"screenshot","desc":"Screenshot of an area"},
    {"key":"Print","action":"exec","command":"screenshot","desc":"Screenshot of an area"},
    {"key":"XF86ScreenSaver","action":"exec","command":"lock","desc":"Lock screen"},

    {"mods":"$mod","key":"h","action":"movefocus","args":"l","desc":"Focus window on the left"},
    {"mods":"$mod","key":"l","action":"movefocus","args":"r","desc":"Focus window on the right"},
    {"mods":"$mod","key":"k","action":"movefocus","args":"u","desc":"Focus window above"},
    {"mods":"$mod","key":"j","action":"movefocus","args":"d","desc":"Focus window below"},

    {"mods":"$mod ALT","key":"m","action":"exec","command":"micMute","desc":"Mute or unmute microphone"},
    {"mods":"$mod ALT","key":"l","action":"exec","command":"mediaNext","desc":"Next track"},
    {"mods":"$mod ALT","key":"h","action":"exec","command":"mediaPrev","desc":"Previous track"},
    {"mods":"$mod ALT","key":"p","action":"exec","command":"mediaToggle","desc":"Play or pause"},

    {"key":"XF86AudioMute","action":"exec","command":"volumeMute","desc":"Mute or unmute sound"},
    {"key":"XF86AudioMicMute","action":"exec","command":"micMute","desc":"Mute or unmute microphone"},
    {"key":"XF86AudioNext","action":"exec","command":"mediaNext","desc":"Next track"},
    {"key":"XF86AudioPrev","action":"exec","command":"mediaPrev","desc":"Previous track"},
    {"key":"XF86AudioPlay","action":"exec","command":"mediaToggle","desc":"Play or pause"},

    {"mods":"$mod SHIFT","key":"h","action":"movewindow","args":"l","desc":"Move window left"},
    {"mods":"$mod SHIFT","key":"l","action":"movewindow","args":"r","desc":"Move window right"},
    {"mods":"$mod SHIFT","key":"k","action":"movewindow","args":"u","desc":"Move window up"},
    {"mods":"$mod SHIFT","key":"j","action":"movewindow","args":"d","desc":"Move window down"},
    {"mods":"$mod SHIFT","key":"c","action":"centerwindow","args":"1","desc":"Center window"},

    {"mods":"$mod","key":"TAB","action":"focusmonitor","args":"+1","desc":"Focus next monitor"},

    {"mods":"$mod","key":"1","action":"focusworkspaceoncurrentmonitor","args":"1","desc":"Go to workspace 1"},
    {"mods":"$mod","key":"2","action":"focusworkspaceoncurrentmonitor","args":"2","desc":"Go to workspace 2"},
    {"mods":"$mod","key":"3","action":"focusworkspaceoncurrentmonitor","args":"3","desc":"Go to workspace 3"},
    {"mods":"$mod","key":"4","action":"focusworkspaceoncurrentmonitor","args":"4","desc":"Go to workspace 4"},
    {"mods":"$mod","key":"5","action":"focusworkspaceoncurrentmonitor","args":"5","desc":"Go to workspace 5"},
    {"mods":"$mod","key":"6","action":"focusworkspaceoncurrentmonitor","args":"6","desc":"Go to workspace 6"},
    {"mods":"$mod","key":"7","action":"focusworkspaceoncurrentmonitor","args":"7","desc":"Go to workspace 7"},
    {"mods":"$mod","key":"8","action":"focusworkspaceoncurrentmonitor","args":"8","desc":"Go to workspace 8"},
    {"mods":"$mod","key":"9","action":"focusworkspaceoncurrentmonitor","args":"9","desc":"Go to workspace 9"},
    {"mods":"$mod","key":"0","action":"focusworkspaceoncurrentmonitor","args":"10","desc":"Go to workspace 10"},

    {"mods":"$mod CTRL","key":"h","action":"workspace","args":"r-1","desc":"Previous workspace"},
    {"mods":"$mod","key":"Left","action":"workspace","args":"r-1","desc":"Previous workspace"},
    {"mods":"$mod CTRL","key":"l","action":"workspace","args":"r+1","desc":"Next workspace"},
    {"mods":"$mod","key":"Right","action":"workspace","args":"r+1","desc":"Next workspace"},

    {"mods":"$mod","key":"mouse_down","action":"workspace","args":"r-1","desc":"Previous workspace"},
    {"mods":"$mod","key":"mouse_up","action":"workspace","args":"r+1","desc":"Next workspace"},
    {"mods":"$mod","key":"mouse:274","action":"killactive","desc":"Close window"},

    {"mods":"$mod SHIFT","key":"1","action":"movetoworkspace","args":"1","desc":"Move window to workspace 1"},
    {"mods":"$mod SHIFT","key":"2","action":"movetoworkspace","args":"2","desc":"Move window to workspace 2"},
    {"mods":"$mod SHIFT","key":"3","action":"movetoworkspace","args":"3","desc":"Move window to workspace 3"},
    {"mods":"$mod SHIFT","key":"4","action":"movetoworkspace","args":"4","desc":"Move window to workspace 4"},
    {"mods":"$mod SHIFT","key":"5","action":"movetoworkspace","args":"5","desc":"Move window to workspace 5"},
    {"mods":"$mod SHIFT","key":"6","action":"movetoworkspace","args":"6","desc":"Move window to workspace 6"},
    {"mods":"$mod SHIFT","key":"7","action":"movetoworkspace","args":"7","desc":"Move window to workspace 7"},
    {"mods":"$mod SHIFT","key":"8","action":"movetoworkspace","args":"8","desc":"Move window to workspace 8"},
    {"mods":"$mod SHIFT","key":"9","action":"movetoworkspace","args":"9","desc":"Move window to workspace 9"},
    {"mods":"$mod SHIFT","key":"0","action":"movetoworkspace","args":"10","desc":"Move window to workspace 10"},

    {"mods":"$mod CTRL SHIFT","key":"l","action":"movetoworkspace","args":"r+1","desc":"Move window to next workspace"},
    {"mods":"$mod SHIFT","key":"Right","action":"movetoworkspace","args":"r+1","desc":"Move window to next workspace"},
    {"mods":"$mod CTRL SHIFT","key":"h","action":"movetoworkspace","args":"r-1","desc":"Move window to previous workspace"},
    {"mods":"$mod SHIFT","key":"Left","action":"movetoworkspace","args":"r-1","desc":"Move window to previous workspace"}
  ]
}