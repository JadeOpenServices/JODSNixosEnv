                            "home-manager-${settings.username}.service"
                        ];
                        systemd.services.display-manager.requires = [
                            "home-manager-${settings.username}.service"
                        ];
                    }

                    # inputs.chaotic.nixosModules.default
                    (./. + "/profiles" + ("/" + settings.profile) + "/configuration.nix")
                ];

